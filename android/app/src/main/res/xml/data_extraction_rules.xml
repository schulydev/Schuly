<?xml version="1.0" encoding="utf-8"?>
<!-- Secure storage is encrypted with a Keystore key that never leaves the device.
     Restoring the files elsewhere leaves data the new key cannot decrypt
     (AEADBadTagException), so they are never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
